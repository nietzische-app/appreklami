# Render API (set these in your host's environment; Dockerfile already defaults the first three)
PORT=3000
DEFAULT_PLAN=free
CORS_ORIGIN=https://admirable-sundae-231bb4.netlify.app,https://*--admirable-sundae-231bb4.netlify.app
# RATE_LIMIT_PER_HOUR=5
# PRO_RENDER_SCALE=2
# ALLOWED_LOCAL_ROOTS=   # leave unset on a public server

# AI copywriting (optional; without a key the built-in templates are used)
# LLM_API_KEY=
# LLM_PROVIDER=openai          # openai (any OpenAI-compatible API) | anthropic
# LLM_MODEL=gpt-4o-mini        # default per provider
# LLM_BASE_URL=                # e.g. another OpenAI-compatible endpoint
# COPY_LANGUAGE=English        # language of the on-screen text, e.g. Turkish
# AI_COPY=0                    # force templates even when a key is set

# Web UI (Netlify -> Site settings -> Environment variables)
# VITE_API_URL=https://<your-render-api-host>
